# Ardor runtime/deployment defaults
# Source checkout stays in repo path; runtime artifacts live under /workspace.

# Runtime storage roots
ARDOR_HOME=/workspace/ArdorRuntime
HF_HOME=/workspace/.cache/huggingface

# Backend and launch target
# native: use local checkpoint + tokenizer
# hf: download/reuse Hugging Face model cache via ARDOR_MODEL_ID
ARDOR_BACKEND=native
ARDOR_LAUNCH_TARGET=cli

# Native backend paths
ARDOR_MODEL_PATH=/workspace/ArdorRuntime/models/ardor/model_last.pt
ARDOR_TOKENIZER_PATH=/workspace/ArdorRuntime/tokenizers/tokenizer_v9.json

# HF backend model selection
ARDOR_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Runtime execution device
ARDOR_DEVICE=cpu

# Optional Hugging Face auth token for gated/private repos
HF_TOKEN=
